# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_SECRET: Master secret used by the project owner to designate the first admin via /api/admin/bootstrap-first-admin
# Keep this secret secure and never expose it in browser code or frontend variables.
ADMIN_BOOTSTRAP_SECRET=1bj+s5lowWSEcZni6RPuU2n36raZaS4r8TyJfkmAyMQW0O5J+ZKXIqedZqi2ROgb

# GOOGLE_APPLICATION_CREDENTIALS: Path to service-account.json downloaded from Firebase Console
# (Project Settings -> Service accounts -> Generate new private key). Used by server-side Admin SDK.
GOOGLE_APPLICATION_CREDENTIALS=./anfabd-firebase-adminsdk.json

# Cloudinary Configuration (Server-Side only): Used for secure product image uploads & asset management
CLOUDINARY_CLOUD_NAME=dnh9rdh01
CLOUDINARY_API_KEY=832237821847377
CLOUDINARY_API_SECRET=FV6FyE9hH2PVv6jITDNEKUttMug
