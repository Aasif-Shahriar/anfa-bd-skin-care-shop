rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Hardened Admin authorization:
    // Requires authenticated caller possessing verified custom claim { admin: true }
    // OR verified record in the /admins/{uid} collection. No hardcoded emails.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection:
    // Anyone can read active published products
    // Only verified administrators can create, update, or delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection:
    // Anyone can create an order as part of checkout
    // Customers can ONLY read their own orders (where userId matches their uid)
    // Only verified administrators can read all orders, update status, or delete orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // User profiles:
    // Users can read and write only their own profile document
    // Administrators can read user records
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reviews collection:
    // Anyone can read reviews
    // Authenticated users can create reviews matching their auth.uid
    // Only the author or an administrator can update or delete reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Administrator records:
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
