{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Jewellery product catalog item with variations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "basePrice": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "mainImage": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "variations": { "type": "array" },
        "specifications": { "type": "object" },
        "featured": { "type": "boolean" },
        "bestseller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "active": { "type": "boolean" },
        "totalStock": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "basePrice", "mainImage", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"] },
        "userId": { "type": "string", "maxLength": 128 },
        "deliveryNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customer", "items", "subtotal", "total", "status", "paymentMethod"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator account record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with contact info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Jewellery catalog products collection"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated administrator credentials"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user profile details"
    }
  }
}
